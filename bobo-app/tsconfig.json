{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@njooba/core": [
        "../packages/core/src"
      ],
      "@yaatal/client": [
        "../packages/client/dist"
      ],
      "@njooba/ai": [
        "../packages/ai/src"
      ],
      "@njooba/shared": [
        "../packages/shared/src"
      ]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-native"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}

