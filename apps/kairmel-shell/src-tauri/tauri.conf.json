{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairmel",
  "version": "0.1.1",
  "identifier": "com.kairmel.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": [
        "main"
      ]
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "com.kairmel.app"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "com.kairmel.app"
          ],
          "host": "auth",
          "path": [
            "/callback"
          ],
          "appLink": false
        }
      ]
    }
  }
}
