{
  "version": 2,
  "name": "bobo-ai-api",
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "GROQ_API_KEY": "@groq-api-key"
  },
  "functions": {
    "api/**/*.ts": {
      "runtime": "edge"
    }
  }
}
