diff --git a/packages/workshop-frontend/src/components/auth/YaatalAuthShell.tsx b/packages/workshop-frontend/src/components/auth/YaatalAuthShell.tsx
new file mode 100644
index 00000000..55714d12
--- /dev/null
+++ b/packages/workshop-frontend/src/components/auth/YaatalAuthShell.tsx
@@ -0,0 +1,93 @@
+import type { ReactNode } from 'react'
+
+// Yaatal's sign-in screens: a brand panel (the woven-Y mark, the promise, the call ring) beside a
+// large form. On narrow screens the panel folds away and the mark sits above the title.
+
+function Mark({ size }: { size: number }) {
+  return (
+    <svg width={size} height={size} viewBox="0 0 256 256" aria-hidden="true">
+      <clipPath id="yaatal-auth-mark"><rect width="256" height="256" rx="56" /></clipPath>
+      <rect width="256" height="256" rx="56" fill="#15302c" />
+      <g clipPath="url(#yaatal-auth-mark)" fill="none" strokeLinejoin="round">
+        <path d="M30 -8 L128 118" stroke="#e85a25" strokeWidth="40" />
+        <path d="M226 -8 L128 118 L128 272" stroke="#15302c" strokeWidth="56" />
+        <path d="M226 -8 L128 118 L128 272" stroke="#f3dcc0" strokeWidth="40" />
+        <path d="M108 190 H148 M108 206 H148" stroke="#e85a25" strokeWidth="6" />
+      </g>
+    </svg>
+  )
+}
+
+function Wordmark({ height }: { height: number }) {
+  return (
+    <svg viewBox="-4 -4 492 108" height={height} aria-hidden="true">
+      <g fill="currentColor">
+        <path d="M0 0H22L35 30L48 0H70L45 54V100H25V54Z" />
+        <path d="M86 100L113 0H129L156 100H136L121 42L106 100Z" />
+        <path d="M172 100L199 0H215L242 100H222L207 42L192 100Z" />
+        <path d="M258 0H322V20H300V100H280V20H258Z" />
+        <path d="M338 100L365 0H381L408 100H388L373 42L358 100Z" />
+        <path d="M424 0H444V80H484V100H424Z" />
+      </g>
+    </svg>
+  )
+}
+
+const ring = 'radial-gradient(circle, transparent 58%, #000 59%, #000 70%, transparent 71%)'
+
+export default function YaatalAuthShell({ title, subtitle, children }: {
+  title: string
+  subtitle?: string
+  children: ReactNode
+}) {
+  return (
+    <div className="grid h-full min-h-0 overflow-y-auto bg-kumo-base lg:grid-cols-2">
+      <aside
+        className="relative hidden flex-col justify-between gap-10 overflow-hidden p-12 lg:flex"
+        style={{ background: '#15302c', color: '#f3ead9' }}
+      >
+        <div className="flex items-center gap-3">
+          <Mark size={44} />
+          <Wordmark height={20} />
+        </div>
+        <div className="relative">
+          <p className="text-5xl font-bold leading-none tracking-tight">
+            Dites-le.
+            <br />
+            <span style={{ color: '#f3dcc0' }}>Yaatal le construit.</span>
+          </p>
+          <p className="mt-6 max-w-md text-lg leading-relaxed" style={{ color: 'rgba(243,234,217,.78)' }}>
+            Parlez de votre idée, en français ou en wolof. Le Playground construit votre site, votre bot
+            WhatsApp ou le firmware de votre objet connecté.
+          </p>
+        </div>
+        <p className="relative text-sm" style={{ color: 'rgba(243,234,217,.6)' }}>
+          Payé en FCFA, partout en zone UEMOA
+        </p>
+        <div
+          aria-hidden="true"
+          className="pointer-events-none absolute -bottom-40 -right-40 h-[28rem] w-[28rem] rounded-full"
+          style={{
+            background: 'repeating-conic-gradient(#e85a25 0deg 1.4deg, transparent 1.4deg 5deg)',
+            maskImage: ring,
+            WebkitMaskImage: ring,
+            opacity: 0.45,
+          }}
+        />
+      </aside>
+      <main className="flex min-h-full flex-col justify-center px-6 py-12 sm:px-12">
+        <div className="mx-auto w-full max-w-md">
+          <div className="mb-8">
+            <div className="mb-8 flex items-center gap-3 text-kumo-default lg:hidden">
+              <Mark size={40} />
+              <Wordmark height={18} />
+            </div>
+            <h1 className="text-3xl font-semibold tracking-tight text-kumo-default">{title}</h1>
+            {subtitle && <p className="mt-2 text-base text-kumo-subtle">{subtitle}</p>}
+          </div>
+          <div className="yaatal-auth">{children}</div>
+        </div>
+      </main>
+    </div>
+  )
+}
