# The board's bundled page: build-app.mjs regenerates it from app/ on every build, test and type
# check. Ignored rather than committed so the overlay never copies a stale bundle over a working
# checkout's freshly built one.
src/generated/

# Generated by `pnpm run types:generate` (wrangler types). Also generated and committed upstream in
# the starter, which is why the overlay must not carry it: this checkout's copy would be a
# half-megabyte file that only ever conflicts.
worker-configuration.d.ts

# Wrangler's own build and dev scratch.
.wrangler/

# tsc output, and the dependency tree.
dist/
node_modules/
