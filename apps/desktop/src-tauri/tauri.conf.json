{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yaatal OS",
  "version": "0.1.0",
  "identifier": "com.yaatal.os",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "capabilities": ["default"] },
    "windows": [
      { "label": "main", "title": "Yaatal OS", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }
    ]
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"] }
}