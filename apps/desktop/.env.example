# Public Shop address rendered in the Shop shell. Never place a token, JWT, or credential in this URL.
VITE_YAATAL_OS_SHOP_URL=http://127.0.0.1:5173

# Server-owned only: loopback Studio sidecar configuration. These values never reach a renderer.
YAATAL_OS_STUDIO_HOST=127.0.0.1
YAATAL_OS_STUDIO_PORT=8484
YAATAL_OS_PYTHON=python

# Explicit local vertical-slice mode. The public base becomes the social link;
# replace localhost with a temporary HTTPS tunnel URL for same-phone testing.
STUDIO_DEMO_MODE=1
YAATAL_COMMERCE_POC=1
YAATAL_COMMERCE_PUBLIC_BASE_URL=http://127.0.0.1:8484
