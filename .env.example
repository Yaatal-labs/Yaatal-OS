# Server-owned topology. Never expose these internal URLs to browser JavaScript.
ENGINE_API_URL=http://yaatal-engine:8080
# Optional override when Engine voice is exposed on a distinct internal host.
# Leave blank to derive ws(s)://.../api/voice/session from ENGINE_API_URL.
ENGINE_VOICE_WS_URL=
HARNESS_URL=http://yaatal-edge-turn:8090

# Engine identity used by Studio for governed writes and the voice WebSocket.
# Prefer a scoped service JWT. Email/password login is an optional fallback.
STUDIO_JWT=
ENGINE_API_EMAIL=
ENGINE_API_PASSWORD=

# Required for public deployments. Operators exchange it for an HTTP-only
# same-origin session; it is never embedded in dashboard assets.
STUDIO_CONTROL_TOKEN=
STUDIO_COOKIE_SECURE=1

# Engine voice currently emits no calibrated ASR confidence. Studio supplies
# this explicit conservative assumption to Harness until the contract does.
STUDIO_VOICE_TRANSCRIPT_CONFIDENCE=0.85

# Current Harness action-proposal backend: mock or minimind.
YAATAL_EDGE_MODEL_BACKEND=mock
YAATAL_HARNESS_FALLBACK=0

# Durable digest-only idempotency receipts. Mount this path persistently.
STUDIO_TURN_LEDGER=/app/data/studio-turns.jsonl

# Explicit test/demo switch. Never silently show mock products in production.
STUDIO_DEMO_MODE=0
STUDIO_EXPOSE_DOCS=0
STUDIO_VERSION=0.2.0
